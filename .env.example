# Copy this file to .env and fill in your values. .env is gitignored.
# On a hosting platform, set these as environment variables instead.

OPENAI_API_KEY=sk-your-key-here

# The model that picks which words to blank. gpt-5.5 is used deliberately:
# smaller models miss idioms and mislabel slang, which defeats the point.
OPENAI_MODEL=gpt-5.5

# From @BotFather on Telegram.
TELEGRAM_TOKEN=123456789:your-bot-token-here

# Optional. Your own Telegram chat id, so /stats works for you and is silently
# ignored for everyone else. Get it from @userinfobot.
ADMIN_CHAT_ID=

# Optional. Where the usage log lives. Point this at a path that survives
# redeploys, or the numbers reset every time you deploy.
CHORUS_DATA_DIR=
