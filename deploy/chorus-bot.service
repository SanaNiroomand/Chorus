[Unit]
Description=Chorus Telegram bot (listen-and-fill English exercises)
Documentation=https://github.com/SanaNiroomand/Chorus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chorus
Group=chorus
WorkingDirectory=/opt/chorus

# Secrets are injected as environment variables by chorus-secrets.service,
# which writes this root-owned 0600 file at boot. Nothing lands in git.
EnvironmentFile=/etc/chorus/env
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/chorus/.venv/bin/python /opt/chorus/bot.py

# Long polling drops out occasionally; always come back.
Restart=always
RestartSec=10s

# Basic hardening - the bot only needs outbound network and its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/chorus
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=chorus-bot

[Install]
WantedBy=multi-user.target
